{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MiniDB：交互式启动",
            "type": "debugpy",
            "request": "launch",
            "module": "database_system.cli.main",
            "args": [
                "-d", "data",
                "-p", "8",
                "-s", "LRU",
                "-v"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "MiniDB：执行 SQL 脚本",
            "type": "debugpy",
            "request": "launch",
            "module": "database_system.cli.main",
            "args": [
                "-d", "data",
                "-f", "script.sql"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "MiniDB：运行单元测试",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "discover",
                "-s",
                "database_system/tests",
                "-v"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
